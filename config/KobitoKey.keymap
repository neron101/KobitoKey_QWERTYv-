#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp LANG1>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <4 3>;
            bindings = <&kp TAB>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q      &kp W      &kp E     &kp R        &kp T      &kp Y      &kp U     &kp I      &kp O       &kp P
&kp A      &kp S      &kp D     &kp F        &kp G      &kp H      &kp J     &kp K      &kp L       &kp MINUS
&kp Z      &kp X      &kp C     &kp V        &kp B      &kp N      &kp M     &kp COMMA  &kp DOT     &kp RS(FSLH)
&kp LSHFT  &kp LCTRL  &kp LGUI  &lt 1 SPACE  &mkp LCLK  &lt 2 RET  &kp BSPC  &kp DEL    &lt 4 RBKT  &mkp RCLK
            >;
        };

        layer_1 {
            display-name = "Raise";
            bindings = <
&kp F1    &kp F2    &kp F3    &kp F4     &kp F5    &kp F6    &kp F7     &kp F8     &kp F9        &kp F10
&kp F11   &kp F12   &kp TAB   &kp ESC    &kp LBKT  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT     &kp C_MUTE
&kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &kp RBKT  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END       &kp C_VOL_UP
&trans    &trans    &trans    &trans     &trans    &trans    &trans     &trans     &trans        &kp C_VOL_DN
            >;
        };

        layer_2 {
            display-name = "Lower";
            bindings = <
&kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &kp N6      &kp N7      &kp N8      &kp N9       &kp N0
&kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)   &kp LS(N0)
&kp LANG2   &kp LANG1   &kp GRAVE   &kp LS(GRAVE) &kp EQUAL &kp BSLH    &kp SQT     &kp SEMI    &kp LS(SQT)  &kp LS(SEMI)
&trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &studio_unlock &trans
            >;
        };

        layer_3 {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp MB4  &mkp MB5  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans
            >;
        };

        layer_4 {
            display-name = "Adjust";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL  &none  &none  &none  &none
&bt BT_CLR    &none         &none         &none         &none         &out OUT_TOG    &none  &none  &none  &none
&none         &none         &none         &none         &none         &studio_unlock  &none  &none  &none  &none
&trans        &trans        &trans        &trans        &trans        &trans          &trans &trans &trans &trans
            >;
        };
    };
};
